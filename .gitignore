# ============================================
# ROOT .gitignore — Paper Trade Project
# ============================================

# ⚠️ CRITICAL: Never commit environment files
.env
.env.local
.env.*.local
.env.development
.env.production

# Dependencies
node_modules/

# Build output
dist/
build/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Local development and review artifacts
/fix_hooks.js
/fix_styles.js
/frontend/lint_output.txt
/frontend/login-desktop-viewport.png
/frontend/login-desktop.png
/frontend/login-mobile.png
