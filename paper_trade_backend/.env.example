# ─────────────────────────────────────────────────────────────
# Paper Trade Backend — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to git.
# ─────────────────────────────────────────────────────────────

PORT=5000

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/papertrade?appName=Cluster0

# JWT Secrets — use long, random strings (min 32 chars recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_long_random_access_token_secret_here
JWT_REFRESH_SECRET=your_very_long_random_refresh_token_secret_here

# Google OAuth Client ID
# Get this from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Frontend URL (for CORS whitelist)
# Development: http://localhost:5173
# Production: https://your-deployed-frontend.com
FRONTEND_URL=http://localhost:5173

# Environment
# Values: development | production
NODE_ENV=development
