# ─────────────────────────────────────────────────────────────
# Paper Trade Frontend — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to git.
# ─────────────────────────────────────────────────────────────

# Backend API URL — development only.
# Production uses the same-origin /api rewrite in vercel.json so secure auth
# cookies are first-party. Do not set VITE_API_URL in the Vercel project.
VITE_API_URL=http://localhost:5001

# Google OAuth Client ID (same as backend)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
